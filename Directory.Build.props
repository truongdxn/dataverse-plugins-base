<Project>

  <PropertyGroup>
    <!-- Single place to bump the version stamped onto every assembly. The solution
         package version in each solution's solution.json is deliberately separate:
         assemblies and solutions version independently. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Deterministic output keeps the packed solution byte-stable across rebuilds,
         so a re-pack with no source change produces an identical assembly. -->
    <Deterministic>true</Deterministic>
    <PathMap Condition="'$(CI)' != ''">$(MSBuildThisFileDirectory)=/_/</PathMap>

    <ArtifactsRoot>$(MSBuildThisFileDirectory)artifacts\</ArtifactsRoot>

    <!--
      Directory.Build.props is imported automatically by every project beneath this folder, so
      exposing the shared props path here lets a plugin project import it with no relative path.
      That keeps the import working wherever the project is created - including when an IDE's
      New Project dialog puts it somewhere unexpected.
    -->
    <DataverseBaseRoot>$(MSBuildThisFileDirectory)</DataverseBaseRoot>
    <PluginBaseRoot>$(MSBuildThisFileDirectory)CRM\Shared\PluginBase\</PluginBaseRoot>

    <!-- Imported by every plugin assembly project. -->
    <AbstractionsSourcesProps>$(PluginBaseRoot)src\Dataverse.Plugins.Abstractions\Abstractions.Sources.props</AbstractionsSourcesProps>

    <!-- Imported by every plugin TEST project; brings in the fake pipeline harness and xunit. -->
    <PluginTestingProps>$(PluginBaseRoot)src\Dataverse.Plugins.Testing\Testing.Sources.props</PluginTestingProps>
  </PropertyGroup>

</Project>
