        { "logicalName": "emailaddress1", "schemaName": "EMailAddress1" },
        { "logicalName": "modifiedon", "schemaName": "ModifiedOn" },
        { "logicalName": "name", "schemaName": "Name" },
        { "logicalName": "ownerid", "schemaName": "OwnerId" },
        { "logicalName": "primarycontactid", "schemaName": "PrimaryContactId" },
        { "logicalName": "statecode", "schemaName": "StateCode" },
        { "logicalName": "statuscode", "schemaName": "StatusCode" },
        { "logicalName": "telephone1", "schemaName": "Telephone1" }
