<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Declared here, not left to the props. When the harness arrives as a NuGet package its props
      reaches the project through restore, and restore itself needs a TargetFramework to run - so
      a project relying on the props for its TFM cannot restore at all. Explicit works both ways.
    -->
    <TargetFramework>net462</TargetFramework>

    <RootNamespace>DvPluginTests</RootNamespace>
    <AssemblyName>DvPluginTests</AssemblyName>

    <!-- Which plugin assembly these tests cover. 'dv test -a <name>' filters on this. -->
    <DataverseTestsFor>DV_TESTS_FOR</DataverseTestsFor>
  </PropertyGroup>

  <!--
    Brings in the fake pipeline harness and a test runner.

    TWO ways it arrives, exactly as for a plugin assembly: the props on disk in the base repo, or
    the NuGet package in a consumer repo. The condition picks whichever applies.
  -->
  <Import Project="$(PluginTestingProps)" Condition="'$(PluginTestingProps)' != ''" />

  <ItemGroup Condition="'$(PluginTestingProps)' == ''">
    <!-- Pin this before sharing the repo; see the note in the assembly template. -->
    <PackageReference Include="Dataverse.Plugins.Testing" Version="DV_PKG_VERSION" />
  </ItemGroup>

  <ItemGroup>
    <!-- The assembly named in DataverseTestsFor above, assumed to be a sibling folder. -->
    <ProjectReference Include="..\DV_TESTS_FOR\DV_TESTS_FOR.csproj" />
  </ItemGroup>

</Project>
