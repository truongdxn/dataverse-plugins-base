<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <RootNamespace>DvPluginAssembly</RootNamespace>
    <AssemblyName>DvPluginAssembly</AssemblyName>

    <!-- Dataverse resolves no dependent assemblies, so everything must land in this one DLL. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <DataverseIsolationMode>DV_ISOLATION</DataverseIsolationMode>
  </PropertyGroup>

  <!--
    Marks this project as a plugin assembly and links in the shared attributes, base classes and
    the solution's generated schema constants. This import is the only thing needed for dv to
    discover the project - there is no central list to add it to.

    Which solution it belongs to is decided by where the project sits: the nearest solution.json
    above it. So it must live under CRM\Plugins\<Solution>\.
  -->
  <!-- Path supplied by the repo-root Directory.Build.props, so this resolves at any depth. -->
  <Import Project="$(AbstractionsSourcesProps)" />

</Project>
