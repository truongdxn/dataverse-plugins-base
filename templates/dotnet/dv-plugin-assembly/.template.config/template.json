{
  "$schema": "http://json.schemastore.org/template",
  "author": "Dataverse plugin base",
  "classifications": [ "Dataverse", "Plugin", "Power Platform" ],
  "identity": "Dataverse.Plugins.Assembly.CSharp",
  "name": "Dataverse plugin assembly",
  "description": "A plugin assembly project that registers itself with the dv tooling. No config file needs editing after creating it.",
  "shortName": "dv-plugin-assembly",
  "tags": { "language": "C#", "type": "project" },
  "sourceName": "DvPluginAssembly",
  "preferNameDirectory": true,
  "symbols": {
    "isolationMode": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "Sandbox", "description": "Sandboxed. Required online." },
        { "choice": "None", "description": "Full trust. On-premises only." }
      ],
      "defaultValue": "Sandbox",
      "replaces": "DV_ISOLATION",
      "description": "Isolation mode the assembly is registered with."
    }
  }
}
