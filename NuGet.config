<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    The local folder feed is the whole distribution mechanism for now. 'build/pack-packages.ps1'
    writes the four packages into artifacts/packages/ and this makes them restorable.

    To publish properly later, replace the 'local' source with the real one - Azure Artifacts,
    GitHub Packages - and add a 'dotnet nuget push' step to CI. Nothing else in the repo changes.
    See docs/packaging.md.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local" value="artifacts\packages" />
  </packageSources>

</configuration>
