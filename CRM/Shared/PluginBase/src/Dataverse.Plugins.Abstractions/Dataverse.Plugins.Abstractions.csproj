<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This project exists so the shared plugin code is compiled and analysed in one place.
    Plugin assemblies do NOT reference the resulting DLL: the Dataverse sandbox loads exactly
    one assembly per plugin registration and resolves no dependencies, so plugin projects LINK
    these sources instead (see Abstractions.Sources.props).

    Targets net462 rather than netstandard2.0 because Microsoft.CrmSdk.CoreAssemblies is a
    .NET Framework package, and because it should compile under exactly the framework the
    plugins it feeds are compiled under.
  -->

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <RootNamespace>Dataverse.Plugins.Abstractions</RootNamespace>
    <AssemblyName>Dataverse.Plugins.Abstractions</AssemblyName>
    <!-- Deliberately NOT a plugin assembly: it is never registered in Dataverse. -->
    <DataversePluginAssembly>false</DataversePluginAssembly>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Dataverse.Plugins.Abstractions</PackageId>
    <Description>
      Registration attributes and plugin base classes for Dataverse plugins, shipped as SOURCE.
      Adding this package compiles the types into your own assembly and marks the project for
      discovery by the dv tooling.
    </Description>
    <PackageTags>dataverse;dynamics365;powerplatform;plugin</PackageTags>

    <!--
      No lib/ assembly ships, on purpose. The Dataverse sandbox loads one assembly per plugin type
      and resolves no dependencies, so a plugin that REFERENCED this would compile and then fail at
      runtime with an assembly-load error. Shipping only source removes the possibility: the types
      end up compiled into the plugin assembly itself, which is the only arrangement that works.
    -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>

    <!-- Nothing here is reachable at runtime, so a symbols package would be misleading. -->
    <IncludeSymbols>false</IncludeSymbols>

    <!-- A package with no lib/ is exactly what is intended; do not warn about it. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.56" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ServiceModel" />
  </ItemGroup>

  <ItemGroup Label="Package contents">
    <!--
      The sources the consumer compiles. contentFiles/cs/any keeps them framework-neutral; the
      props below is what actually turns them into Compile items, so PackageCopyToOutput and
      friends are deliberately not set - nothing should be copied anywhere.
    -->
    <None Include="Registration\**\*.cs" Pack="true" PackagePath="contentFiles\cs\any\Registration" />
    <None Include="Runtime\**\*.cs" Pack="true" PackagePath="contentFiles\cs\any\Runtime" />

    <!--
      buildTransitive rather than build, so a project referencing this package indirectly still
      gets the source and the markers. Named after the package id, which is what MSBuild imports.
    -->
    <None Include="Abstractions.Sources.props"
          Pack="true"
          PackagePath="buildTransitive\Dataverse.Plugins.Abstractions.props" />
  </ItemGroup>

</Project>
