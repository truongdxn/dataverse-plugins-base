<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <RootNamespace>Dataverse.Plugins.Testing</RootNamespace>
    <AssemblyName>Dataverse.Plugins.Testing</AssemblyName>

    <!-- Not a plugin assembly: it never gets registered, so 'dv' must not discover it. -->
    <DataversePluginAssembly>false</DataversePluginAssembly>

    <!--
      net462 because it is referenced by test projects that reference net462 plugin assemblies.
      Matching the plugin's own framework is what lets a test instantiate the plugin directly.
    -->
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Dataverse.Plugins.Testing</PackageId>
    <Description>
      A fake Dataverse pipeline for unit testing plugins: PluginTestHost plus in-memory
      IPluginExecutionContext, ITracingService and IOrganizationService. No connection or
      environment needed.
    </Description>
    <PackageTags>dataverse;dynamics365;powerplatform;plugin;testing</PackageTags>

    <!--
      Unlike the abstractions, this DOES ship as an ordinary assembly. Test projects are never
      loaded by the Dataverse sandbox, so the one-assembly constraint that forces the abstractions
      to ship as source does not apply here.
    -->
  </PropertyGroup>

  <ItemGroup Label="Package contents">
    <!--
      Markers and the test-framework bundle for consuming test projects. buildTransitive so it
      still applies through an indirect reference. Named after the package id, which is what
      MSBuild looks for.
    -->
    <None Include="Testing.Sources.props"
          Pack="true"
          PackagePath="buildTransitive\Dataverse.Plugins.Testing.props" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.Xrm.Sdk ONLY. This project deliberately does not reference
      Dataverse.Plugins.Abstractions: those types are compiled into each plugin assembly
      separately, so a reference here would produce a type that only LOOKS like the plugin's.
      See PluginTestHost for the full explanation.
    -->
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.56" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
