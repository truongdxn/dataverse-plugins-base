<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">

  <Metadata>
    <Identity Id="Dataverse.Plugins.VsCommands.29d3e9c7-d1df-48ff-abd4-712cc61fcb61"
              Version="1.0.0"
              Language="en-US"
              Publisher="Dataverse plugin base" />
    <DisplayName>Dataverse plugin commands</DisplayName>
    <Description xml:space="preserve">Runs the dv CLI from Solution Explorer: build, test, validate and sync one plugin assembly, pack the solution .zip, refresh the schema and message caches, and scaffold new solutions, assemblies, tests and plugin classes. Output goes to a Dataverse pane in the Output window. Requires a repo with dv.json in it.</Description>
    <Tags>Dataverse;Dynamics 365;Power Platform;plugin</Tags>
  </Metadata>

  <Installation>
    <!--
      Community covers every paid edition too. Build Tools is excluded on purpose: it has no
      Solution Explorer, so the menus would install and never appear.
    -->
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,18.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>

  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.5,)" />
  </Dependencies>

  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,18.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>

  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>

</PackageManifest>
